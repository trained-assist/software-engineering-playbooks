{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trained-assist/contracts/execution-plan.schema.json",
  "title": "Execution Plan v1",
  "description": "Конкретное исполнение методики: pinned playbook revision, стабильные stepId, обязательные гейты, ожидания и внешние операции. Компилируется из Playbook v1 (P14) и не запускает ничего сам. Checklist — view над planId, а не отдельный объект. См. docs/REAL-PLAYBOOKS-PLAN-ADAPTATION.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "compiledPlanRevision",
    "profileId",
    "userTaskId",
    "continuationOwner",
    "playbook",
    "stages",
    "steps",
    "completionPolicy",
    "readiness"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "planId": { "type": "string", "pattern": "^plan_[0-9a-f]{16}$" },
    "compiledPlanRevision": {
      "type": "integer",
      "minimum": 1,
      "description": "Растёт при адаптации плана (feature/integration split, migration dependency). Уже запущенные шаги не перестраиваются: правка definition'а даёт новый planId и новые stepId, а этот план продолжает pinned-ревизию."
    },
    "profileId": { "type": "string", "minLength": 1 },
    "userTaskId": {
      "type": "string",
      "minLength": 1,
      "description": "План не заменяет пользовательскую задачу: все шаги плана сохраняют userTaskId этой цели."
    },
    "gtdId": {
      "type": ["string", "null"],
      "description": "Запись контроля одной User Task. null = задача не под контролем; появление gtdId — только через явную регистрацию."
    },
    "continuationOwner": {
      "enum": ["gtd", "output"],
      "description": "Единственный владелец продолжения. Один исход не порождает follow-up и в Output, и в GTD."
    },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playbookRef", "playbookId", "playbookVersion", "artifactHash", "pinnedAt"],
      "properties": {
        "playbookRef": { "type": "string", "minLength": 1 },
        "playbookId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "playbookVersion": { "type": "integer", "minimum": 1 },
        "artifactHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceRevision": { "type": ["string", "null"] },
        "docRef": { "type": ["string", "null"] },
        "pinnedAt": { "type": "string", "minLength": 1 },
        "compiledOperationId": { "type": ["string", "null"] }
      }
    },
    "goalDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{32}$" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "provided"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "derive": { "type": ["string", "null"] },
          "provided": { "type": "boolean" },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ref": { "type": ["string", "null"] },
          "scope": { "type": ["string", "null"] }
        }
      },
      "description": "Только имена/refs/scopes. Значение binding'а в плане не хранится."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stepIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "stepIds": { "type": "array", "items": { "type": "string", "pattern": "^stp_[0-9a-z]{12,32}$" } }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "planDependencies": {
      "type": "array",
      "description": "Зависимость от шага другого плана (интеграция начинается после доказанного merge).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "planId", "stepId"],
        "properties": {
          "kind": { "enum": ["requires_plan_step"] },
          "planId": { "type": "string", "minLength": 1 },
          "stepId": { "type": "string", "minLength": 1 },
          "when": { "enum": ["passed"] }
        }
      }
    },
    "completionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredGatesDisableable", "acceptanceRequiresFreshEvidence"],
      "properties": {
        "requiredGatesDisableable": {
          "const": false,
          "description": "Обязательный гейт нельзя выключить; разрешённое исключение фиксируется actor/reason/evidence."
        },
        "acceptanceRequiresFreshEvidence": { "const": true },
        "maxAttemptsFromDefinition": { "type": "integer", "minimum": 1 }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolvedValidators"],
      "properties": {
        "unresolvedValidators": {
          "type": "array",
          "description": "Named validators, которые не разрешены в этом рантайме. Их отсутствие не делает шаг зелёным: гейт даёт inconclusive, а не pass.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stepId", "validator"],
            "properties": {
              "stepId": { "type": "string", "minLength": 1 },
              "stepKey": { "type": "string" },
              "validator": { "type": "string", "minLength": 1 }
            }
          }
        },
        "externalOperationRefs": { "type": "array", "items": { "type": "object" } },
        "durableWaits": { "type": "array", "items": { "type": "object" } }
      }
    },
    "adaptation": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "Evidence адаптации: что разделено, какая зависимость добавлена и почему.",
      "properties": {
        "kind": { "type": "string" },
        "changes": { "type": "array", "items": { "type": "object" } },
        "pinned": { "type": "object" },
        "derivedFrom": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "planId": { "type": "string", "minLength": 1 },
            "compiledPlanRevision": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "derivedFrom": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "compiledPlanRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "migration": { "type": ["object", "null"], "additionalProperties": true },
    "definitionBytesHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 сохранённой копии definition'а, из которой собраны шаги. Проверяется при каждой загрузке: активный план продолжает pinned-ревизию."
    },
    "stepStates": { "type": "object" },
    "stepEvidence": { "type": "object" },
    "stepAttempts": { "type": "object" },
    "stepExternalOps": { "type": "object" },
    "awaiting": { "type": "object" },
    "conditions": { "type": "object" },
    "planDependenciesEvidence": { "type": "object" },
    "status": { "enum": ["compiled", "active", "stopped", "completed", "cancelled"] },
    "blocker": { "type": ["object", "null"] },
    "acceptance": { "type": ["object", "null"] },
    "openedAt": { "type": "string" },
    "cancelledAt": { "type": "string" },
    "cancelReason": { "type": ["string", "null"] }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "stepKey", "stageId", "ordinal", "title", "executionKind", "gate", "deadlines", "maxAttempts", "dependsOn"],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^stp_[0-9a-z]{12,32}$",
          "description": "Идентификатор шага в плане: sha256(playbookId@artifactHash#stepKey). Присваивается один раз и сохраняется между попытками."
        },
        "stepKey": {
          "type": "string",
          "minLength": 1,
          "description": "Семантический ключ шага внутри definition'а (stageId#ordinal или stageId:step.id). Сопоставляет версии, но идентификатором не является."
        },
        "stageId": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "stepType": { "type": ["string", "null"] },
        "executionKind": { "enum": ["agent", "programmatic"] },
        "executorRole": { "type": ["string", "null"] },
        "minimumModelLevel": { "type": ["string", "null"] },
        "contextBudget": { "type": ["string", "null"] },
        "instructionsRef": { "type": ["string", "null"] },
        "adapter": {
          "type": "object",
          "additionalProperties": true,
          "description": "Как шаг получен из definition'а. synthetic=true — узел не из артефакта (например migration), и он не притворяется скомпилированным.",
          "properties": {
            "compiledFrom": { "type": ["object", "null"] },
            "legacyOrdinalMapping": { "type": "boolean" },
            "synthetic": { "type": "string" }
          }
        },
        "dependencyKind": { "type": "string" },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "validators"],
          "properties": {
            "required": {
              "const": true,
              "description": "Обязательный гейт шага. Для планов без шага с обязательным гейтом это false, но проверка приёмки всё равно требует evidence по каждому шагу."
            },
            "validators": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "resolved"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "resolved": {
                    "type": "boolean",
                    "description": "Разрешён ли validator в этом рантайме. Неразрешённый validator даёт inconclusive, а не pass."
                  }
                }
              }
            },
            "alreadyDone": { "type": "array", "items": { "type": "object" } },
            "enforcement": { "type": "string" }
          }
        },
        "wait": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "Вид ожидания: user_input (нужен durable awaitingInputId), condition (внешнее условие, слот освобождается) или timer.",
          "properties": {
            "kind": { "enum": ["user_input", "condition", "timer"] },
            "requiresAwaitingInputId": { "type": "boolean" },
            "deadlineKind": { "enum": ["wait_deadline"] },
            "timeoutSec": { "type": ["integer", "null"] },
            "pollEverySec": { "type": "integer", "minimum": 60 },
            "delayAfterSec": { "type": "integer", "minimum": 0 },
            "conditionValidator": { "type": ["string", "null"] },
            "requiresDurableRecord": { "type": "boolean" }
          }
        },
        "deadlines": {
          "type": "object",
          "additionalProperties": false,
          "description": "run deadline (попытка), wait deadline (ожидание) и task deadline различаются: суточный wait не делает run timeout'ом всей цели.",
          "properties": {
            "runDeadlineSec": { "type": ["integer", "null"], "minimum": 1 },
            "waitDeadlineSec": { "type": ["integer", "null"], "minimum": 1 },
            "taskDeadlineSec": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^stp_[0-9a-z]{12,32}$" } },
        "externalOperation": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "Внешняя операция шага: результат фиксируется как externalOperationRef до ожидания. run_id внешнего сервиса — не платформенный runId.",
          "properties": {
            "kind": { "enum": ["pull_request", "actions_run", "pull_request_state", "deploy_probe", "real_scenario_probe", "schema_migration"] },
            "provider": { "type": "string" },
            "required": { "type": "boolean" },
            "ref": { "type": ["object", "null"] }
          }
        },
        "hooks": { "type": "object" },
        "workspaceRefRequired": { "type": "boolean" }
      }
    }
  }
}